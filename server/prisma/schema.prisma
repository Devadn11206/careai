generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}


enum UserRole {
  PATIENT
  DOCTOR
  ADMIN
}

enum DoctorStatus {
  PENDING_VERIFICATION
  UNDER_REVIEW
  VERIFIED
  REJECTED
  SUSPENDED
}

enum AppointmentStatus {
  SCHEDULED
  IN_PROGRESS
  COMPLETED
  CANCELLED
  PENDING
  REJECTED
}

enum ConsultationType {
  VIDEO
  IN_PERSON
}

model HealthMetric {
  id          String @id @default(cuid())
  patient     User   @relation("UserHealthMetrics", fields: [patientId], references: [id])
  patientId   String
  metricsJson String

  createdAt DateTime @default(now())
}

model User {
  id           String   @id @default(cuid())
  name         String
  email        String   @unique
  passwordHash String
  role         UserRole
  profilePicUrl String?
  phone         String?
  age           Int?
  gender        String?

  // Optional doctor-specific metadata (used when role == DOCTOR)
  specialization     String?
  experienceYears    Int?
  qualification      String?
  registrationNumber String?
  medicalCouncil     String?
  verificationDocumentUrl  String?
  verificationDocumentName String?
  rating             Float?        @default(4.8)
  doctorStatus       DoctorStatus? @default(PENDING_VERIFICATION)
  about              String?
  hospital           String?
  consultationFee    Float?

  patientAppointments Appointment[] @relation("PatientAppointments")
  doctorAppointments  Appointment[] @relation("DoctorAppointments")

  // Additional relations
  healthMetrics    HealthMetric[]   @relation("UserHealthMetrics")
  doctorSchedule   DoctorSchedule?  @relation("UserDoctorSchedule")
  timeSlots        TimeSlot[]       @relation("UserTimeSlots")
  sentMessages     ChatMessage[]    @relation("MessageSender")
  receivedMessages ChatMessage[]    @relation("MessageReceiver")
  patientConsultationSummaries ConsultationSummary[] @relation("PatientConsultationSummaries")
  doctorConsultationSummaries  ConsultationSummary[] @relation("DoctorConsultationSummaries")

  // Medication reminders
  medicationOrders           MedicationOrder[]          @relation("PatientMedicationOrders")
  prescribedMedicationOrders MedicationOrder[]          @relation("MedicationPrescriber")
  medicationAdherence        MedicationAdherence[]      @relation("PatientMedicationAdherence")
  medicationAlertsAsDoctor   MedicationMissedDoseAlert[] @relation("DoctorMedicationAlerts")
  medicationAlertsAsPatient  MedicationMissedDoseAlert[] @relation("PatientMedicationAlerts")
  alertsAsPatient            Alert[]                     @relation("PatientAlerts")
  alertsAsDoctor             Alert[]                     @relation("DoctorTargetedAlerts")
  aiInsights                 AiInsight[]                 @relation("PatientAiInsights")
  patientPrescriptions       Prescription[]              @relation("PatientPrescriptions")
  doctorPrescriptions        Prescription[]              @relation("DoctorPrescriptions")
  medicalRecords             MedicalRecord[]             @relation("PatientMedicalRecords")
  grantedAccessTo            DoctorAccessPermission[]    @relation("PatientGrantedAccess")
  doctorAccesses             DoctorAccessPermission[]    @relation("DoctorAccessPermissions")
  
  // Verification relations
  doctorDocuments            DoctorDocument[]            @relation("DoctorDocumentRelation")
  doctorVerificationLogs     DoctorVerificationLog[]     @relation("DoctorLogRelation")
  adminReviewsPerformed      AdminReview[]               @relation("AdminReviewRelation")
  doctorAffiliations         HospitalAffiliation[]       @relation("DoctorAffiliations")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model MedicationOrder {
  id                   String  @id @default(cuid())
  patient              User    @relation("PatientMedicationOrders", fields: [patientId], references: [id])
  patientId            String

  prescribedBy         User?   @relation("MedicationPrescriber", fields: [prescribedByDoctorId], references: [id])
  prescribedByDoctorId String?

  name         String
  dosage       String
  instructions String?

  frequency  String
  timesJson  String
  startDate  String
  endDate    String
  durationDays Int
  active     Boolean @default(true)

  adherence MedicationAdherence[]
  alerts    MedicationMissedDoseAlert[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([patientId, startDate, endDate])
}

model MedicationAdherence {
  id           String @id @default(cuid())
  doseId       String @unique

  patient   User @relation("PatientMedicationAdherence", fields: [patientId], references: [id])
  patientId String

  medicationOrder MedicationOrder @relation(fields: [medicationId], references: [id])
  medicationId    String

  scheduledAt DateTime
  status      String
  takenAt     DateTime?
  updatedAt   DateTime @default(now())
  updatedBy   String

  @@index([patientId, scheduledAt])
  @@index([medicationId, scheduledAt])
}

model MedicationMissedDoseAlert {
  id       String @id @default(cuid())
  doseId   String

  doctor   User @relation("DoctorMedicationAlerts", fields: [doctorId], references: [id])
  doctorId String

  patient   User @relation("PatientMedicationAlerts", fields: [patientId], references: [id])
  patientId String

  medicationOrder MedicationOrder @relation(fields: [medicationId], references: [id])
  medicationId    String

  scheduledAt   DateTime
  status        String   @default("NEW")
  createdAt     DateTime @default(now())
  acknowledgedAt DateTime?

  @@index([doctorId, status, createdAt])
  @@index([patientId, createdAt])
  @@index([medicationId, createdAt])
}

model Appointment {
  id              String            @id @default(cuid())
  patient         User              @relation("PatientAppointments", fields: [patientId], references: [id])
  patientId       String
  doctor          User              @relation("DoctorAppointments", fields: [doctorId], references: [id])
  doctorId        String
  date            String
  time            String
  status          AppointmentStatus @default(SCHEDULED)
  type            String
  consultationType ConsultationType

  // Optional linkage to a generated slot and OPD-style token
  slotId     String?
  tokenNumber Int?
  symptoms    String?
  notes       String?

  chatMessages ChatMessage[] @relation("AppointmentMessages")
  consultationSummaries ConsultationSummary[] @relation("AppointmentConsultationSummaries")
  prescriptions Prescription[] @relation("AppointmentPrescriptions")

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DoctorSchedule {
  id                String   @id @default(cuid())
  doctor            User     @relation("UserDoctorSchedule", fields: [doctorId], references: [id])
  doctorId          String   @unique
  scheduleJson      String   // JSON-encoded DaySchedule[] from frontend
  slotDuration      Int      // minutes
  defaultMaxPatients Int

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TimeSlot {
  id         String @id
  doctor     User   @relation("UserTimeSlots", fields: [doctorId], references: [id])
  doctorId   String
  date       String
  startTime  String
  endTime    String
  maxPatients Int
  bookedCount Int   @default(0)
  isBlocked   Boolean @default(false)
  isEmergency Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ChatMessage {
  id               String      @id @default(cuid()) @map("message_id")
  appointment      Appointment @relation("AppointmentMessages", fields: [appointmentId], references: [id])
  appointmentId    String      @map("appointment_id")
  sender           User        @relation("MessageSender", fields: [senderId], references: [id])
  senderId         String      @map("sender_id")
  receiver         User        @relation("MessageReceiver", fields: [receiverId], references: [id])
  receiverId       String      @map("receiver_id")
  
  content          String      @map("message_text")
  messageType      String      @default("TEXT") // TEXT, IMAGE, PDF, PRESCRIPTION, VOICE, SUMMARY
  attachmentUrl    String?     @map("attachment_url")
  attachmentName   String?
  attachmentType   String?
  
  isRead           Boolean     @default(false)
  isDelivered      Boolean     @default(false)
  
  createdAt DateTime @default(now()) @map("timestamp")

  @@index([appointmentId, createdAt])
  @@index([senderId, receiverId, createdAt])
  @@map("chat_messages")
}

model ConsultationSummary {
  id            String      @id @default(cuid())
  appointment   Appointment @relation("AppointmentConsultationSummaries", fields: [appointmentId], references: [id])
  appointmentId String
  patient       User        @relation("PatientConsultationSummaries", fields: [patientId], references: [id])
  patientId     String
  doctor        User        @relation("DoctorConsultationSummaries", fields: [doctorId], references: [id])
  doctorId      String

  transcript         String
  symptoms           String
  possibleCondition  String
  keyDiscussionPoints String
  recommendations    String
  followUpInstructions String
  rawJson            String
  disclaimer         String?

  createdAt DateTime @default(now())

  @@index([doctorId, patientId, createdAt])
  @@index([appointmentId, createdAt])
}

enum AlertSeverity {
  CRITICAL
  HIGH
  MEDIUM
  LOW
  INFO
}

enum AlertStatus {
  NEW
  ACKNOWLEDGED
  RESOLVED
}

model Alert {
  id        String        @id @default(cuid())
  patient   User          @relation("PatientAlerts", fields: [patientId], references: [id])
  patientId String
  
  // Doctors can be targeted or it can be a general broadcast
  doctor    User?         @relation("DoctorTargetedAlerts", fields: [doctorId], references: [id])
  doctorId  String?
  
  type      String        // e.g., 'ML_RISK', 'VITALS', 'EMERGENCY'
  severity  AlertSeverity
  message   String
  status    AlertStatus   @default(NEW)
  
  createdAt DateTime      @default(now())
  
  @@index([patientId, createdAt])
  @@index([doctorId, status, createdAt])
}

model AiInsight {
  id              String   @id @default(cuid())
  patient         User     @relation("PatientAiInsights", fields: [patientId], references: [id])
  patientId       String
  heartRate       Int
  bloodPressure   String
  glucose         Int
  aiWellnessScore Int
  recoveryScore   Int      @default(85)
  summary         String   @default("Heart rate variability remains optimal for recovery. Glucose levels stabilized after last recorded meal.")
  confidence      Float
  diabetesRisk    Int      @default(0)
  hypertensionRisk Int      @default(0)
  heartDiseaseRisk Int      @default(0)
  timestamp       DateTime @default(now())

  @@index([patientId, timestamp])
}

model Prescription {
  id              String   @id @default(cuid())
  patient         User     @relation("PatientPrescriptions", fields: [patientId], references: [id])
  patientId       String
  doctor          User     @relation("DoctorPrescriptions", fields: [doctorId], references: [id])
  doctorId        String
  appointment     Appointment? @relation("AppointmentPrescriptions", fields: [appointmentId], references: [id])
  appointmentId   String?

  medicines       String   // JSON string of medicines
  diagnosis       String?
  notes           String?
  fileUrl         String?
  fileName        String?
  aiExtractedJson String?  // Extracted data from AI
  confidenceScore Float?
  
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([patientId, createdAt])
  @@index([doctorId, createdAt])
}

model MedicalRecord {
  id          String   @id @default(cuid())
  patient     User     @relation("PatientMedicalRecords", fields: [patientId], references: [id])
  patientId   String
  
  type        String   // 'LAB_REPORT', 'SCAN', 'PRESCRIPTION', 'SUMMARY', 'ALLERGY', 'CHRONIC'
  title       String
  description String?
  fileUrl     String
  fileName    String
  fileType    String   // 'pdf', 'image', 'docx'
  
  date        DateTime @default(now())
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([patientId, type])
  @@index([patientId, createdAt])
}

enum AccessStatus {
  PENDING
  GRANTED
  REVOKED
  EXPIRED
}

enum AccessType {
  ONE_TIME
  APPOINTMENT_ONLY
  PERMANENT
}

model DoctorAccessPermission {
  id          String       @id @default(cuid())
  patient     User         @relation("PatientGrantedAccess", fields: [patientId], references: [id])
  patientId   String
  doctor      User         @relation("DoctorAccessPermissions", fields: [doctorId], references: [id])
  doctorId    String
  
  status      AccessStatus @default(PENDING)
  accessType  AccessType   @default(APPOINTMENT_ONLY)
  
  expiresAt   DateTime?
  grantedAt   DateTime?
  
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  @@unique([patientId, doctorId])
  @@index([doctorId, status])
}
model DoctorDocument {
  id          String   @id @default(cuid())
  doctor      User     @relation("DoctorDocumentRelation", fields: [doctorId], references: [id])
  doctorId    String
  
  type        String   // 'LICENSE', 'CERTIFICATE', 'ID_PROOF', 'DEGREE', 'AFFILIATION'
  title       String
  fileUrl     String
  fileName    String
  fileType    String
  
  createdAt   DateTime @default(now())
}

model DoctorVerificationLog {
  id          String   @id @default(cuid())
  doctor      User     @relation("DoctorLogRelation", fields: [doctorId], references: [id])
  doctorId    String
  
  oldStatus   DoctorStatus
  newStatus   DoctorStatus
  reason      String?
  adminId     String?
  
  createdAt   DateTime @default(now())
}

model AdminReview {
  id          String   @id @default(cuid())
  admin       User     @relation("AdminReviewRelation", fields: [adminId], references: [id])
  adminId     String
  targetId    String   // Doctor ID
  
  comments    String?
  decision    String   // 'APPROVED', 'REJECTED', 'DOCUMENTS_REQUESTED'
  
  createdAt   DateTime @default(now())
}

model Hospital {
  id                String   @id @default(cuid())
  name              String
  type              String   // 'GOVERNMENT', 'PRIVATE', 'SPECIALTY'
  description       String?
  imageUrl          String?
  emergencyStatus   Boolean  @default(true)
  rating            Float    @default(4.5)
  departments       String?  // JSON string
  timings           String?
  verified          Boolean  @default(false)
  queueWaitTime     Int      @default(0) // in minutes
  activePatients    Int      @default(0)
  
  location          HospitalLocation?
  affiliations      HospitalAffiliation[]
  facilities        HealthcareFacility[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model HospitalLocation {
  id          String   @id @default(cuid())
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId  String   @unique
  
  address     String
  city        String
  state       String?
  country     String
  latitude    Float
  longitude   Float
  
  createdAt DateTime @default(now())
}

model HospitalAffiliation {
  id          String   @id @default(cuid())
  doctor      User     @relation("DoctorAffiliations", fields: [doctorId], references: [id])
  doctorId    String
  hospital    Hospital @relation(fields: [hospitalId], references: [id])
  hospitalId  String
  
  status      String   // 'PENDING', 'VERIFIED', 'REVOKED'
  department  String?
  
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([doctorId, hospitalId])
}

model HealthcareFacility {
  id          String   @id @default(cuid())
  name        String
  type        String   // 'PHARMACY', 'LAB', 'MRI_CENTER', 'XRAY_CENTER'
  hospital    Hospital? @relation(fields: [hospitalId], references: [id])
  hospitalId  String?
  
  address     String
  latitude    Float
  longitude   Float
  
  verified    Boolean  @default(true)
  
  createdAt DateTime @default(now())
}

model AuditLog {
  id          String   @id @default(cuid())
  userId      String?
  action      String   // 'LOGIN', 'LOGOUT', 'CONSULTATION_START', 'PRESCRIPTION_GEN', 'AI_ACTION', 'RECORD_ACCESS', 'APPROVAL'
  details     String?  // JSON or text
  targetId    String?  // e.g., Patient ID or Doctor ID
  targetName  String?
  ipAddress   String?
  timestamp   DateTime @default(now())
  
  @@index([userId, action])
  @@index([timestamp])
}

model SupportTicket {
  id          String   @id @default(cuid())
  userId      String
  role        UserRole
  subject     String
  message     String
  status      String   @default("OPEN") // 'OPEN', 'IN_PROGRESS', 'RESOLVED', 'CLOSED'
  priority    String   @default("MEDIUM") // 'LOW', 'MEDIUM', 'HIGH', 'CRITICAL'
  
  response    String?
  resolvedAt  DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([userId, status])
}

model FraudAlert {
  id          String   @id @default(cuid())
  type        String   // 'SUSPICIOUS_LOGIN', 'FAKE_DOCTOR_CLAIM', 'PRESCRIPTION_ABUSE', 'SPAM'
  severity    AlertSeverity
  details     String
  userId      String?
  status      AlertStatus @default(NEW)
  
  createdAt   DateTime @default(now())
  
  @@index([type, status])
}

model SystemStatus {
  id          String   @id @default(cuid())
  service     String   // 'API', 'DATABASE', 'SOCKET', 'GROQ', 'MAPS', 'OCR'
  status      String   // 'ONLINE', 'DEGRADED', 'OFFLINE'
  latency     Int?     // in ms
  lastChecked DateTime @default(now())
  
  @@index([service])
}

model Emergency {
  id              String   @id @default(cuid())
  patientId       String?
  patientName     String?  // Fallback if not registered
  type            String   // 'CARDIAC', 'TRAUMA', 'RESPIRATORY', 'STROKE', 'OTHER'
  severity        AlertSeverity @default(CRITICAL)
  status          String   @default("PENDING") // 'PENDING', 'RESPONDING', 'RESOLVED', 'CANCELLED'
  
  latitude        Float
  longitude       Float
  address         String?
  
  assignedHospitalId String?
  assignedDoctorId   String?
  assignedAmbulanceId String?

  startTime       DateTime @default(now())
  endTime         DateTime?
  
  @@index([status, severity])
}

model Ambulance {
  id              String   @id @default(cuid())
  plateNumber     String   @unique
  driverName      String
  driverPhone     String
  status          String   @default("IDLE") // 'IDLE', 'RESPONDING', 'ON_SITE', 'EN_ROUTE_TO_HOSPITAL'
  
  latitude        Float
  longitude       Float
  
  currentEmergencyId String?
  
  lastUpdated     DateTime @updatedAt
  
  @@index([status])
}
